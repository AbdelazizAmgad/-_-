<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CINEMA</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary-color: #E50914; /* Netflix Red */
            --bg-color: #0b0b0b;
            --card-bg: #1a1a1a;
        }
        body { 
            background-color: var(--bg-color); 
            color: #fff; 
            font-family: 'Poppins', sans-serif; 
            overflow-x: hidden;
        }
        /* Navbar Glassmorphism */
        .navbar { 
            background: rgba(11, 11, 11, 0.8) !important; 
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255,255,255,0.05);
            padding: 15px 0;
            transition: 0.3s;
        }
        .navbar-brand { 
            color: var(--primary-color) !important; 
            font-weight: 800; 
            font-size: 28px; 
            letter-spacing: 2px; 
        }
        .nav-link { 
            color: #fff !important; 
            font-weight: 400; 
            margin-left: 15px;
            transition: 0.3s;
        }
        .nav-link:hover { color: var(--primary-color) !important; }
        
        /* Movie Cards */
        .movie-card {
            background-color: var(--card-bg);
            border: none;
            border-radius: 12px;
            overflow: hidden;
            transition: all 0.4s ease;
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
        }
        .movie-card:hover {
            transform: translateY(-10px) scale(1.02);
            box-shadow: 0 10px 30px rgba(229, 9, 20, 0.3);
        }
        .movie-img {
            height: 400px;
            object-fit: cover;
            width: 100%;
        }
        .btn-netflix {
            background-color: var(--primary-color);
            color: white;
            border: none;
            font-weight: 600;
            border-radius: 5px;
            padding: 10px;
            transition: 0.3s;
        }
        .btn-netflix:hover {
            background-color: #b20710;
            color: white;
            transform: scale(1.05);
        }
        .footer {
            margin-top: 100px;
            padding: 30px 0;
            text-align: center;
            color: #666;
            border-top: 1px solid rgba(255,255,255,0.05);
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark sticky-top">
        <div class="container">
            <a class="navbar-brand" href="/Customer/Home/Index"><i class="fas fa-film me-2"></i>CINEMA</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="/Customer/Home/Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Admin/Home/Index">Admin Panel</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container mt-5">
        @RenderBody()
    </div>

    <div class="footer">
        <p>&copy; 2024 Cinema Booking System. Built with ASP.NET Core MVC.</p>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>