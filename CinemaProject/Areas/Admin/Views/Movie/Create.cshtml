@model CinemaProject.Models.Movie

@{
    ViewData["Title"] = "Create Movie";
    var actors = ViewBag.Actors as List<CinemaProject.Models.Actor>;
    var selectedActors = ViewBag.SelectedActors as List<int>;
}

<h1>Create Movie</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger"></div>
            
            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Price" class="control-label"></label>
                <input asp-for="Price" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="DateTime" class="control-label">Date & Time</label>
                <input asp-for="DateTime" class="form-control" type="datetime-local" />
                <span asp-validation-for="DateTime" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Category</label>
                <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.CategoryId"></select>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Cinema</label>
                <select asp-for="CinemaId" class="form-control" asp-items="ViewBag.CinemaId"></select>
            </div>

            <div class="form-group mb-3 form-check">
                <input asp-for="Status" class="form-check-input" type="checkbox" checked />
                <label asp-for="Status" class="form-check-label">Available for Booking</label>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Main Image</label>
                <input type="file" name="MainImg" class="form-control" accept="image/*" required />
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Sub Images (You can select multiple)</label>
                <input type="file" name="SubImages" class="form-control" accept="image/*" multiple />
            </div>

            <div class="form-group mb-3">
                <label class="control-label d-block mb-2">Actors</label>
                @foreach (var actor in actors)
                {
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" name="SelectedActors" value="@actor.Id" 
                               @(selectedActors != null && selectedActors.Contains(actor.Id) ? "checked" : "") />
                        <label class="form-check-label">@actor.Name</label>
                    </div>
                }
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}