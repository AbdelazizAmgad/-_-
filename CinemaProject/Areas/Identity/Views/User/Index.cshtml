<h2>User Management</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        <!-- Data from database -->
        <!-- Example row -->
        <tr>
            <td>Ahmed Ali</td>
            <td>ahmed@email.com</td>
            <td>Active</td>
            <td>
                <form asp-action="Lock" method="post" class="d-inline">
                    <input type="hidden" name="userId" value="user-id-here" />
                    <button type="submit" class="btn btn-danger btn-sm">Lock</button>
                </form>
                <form asp-action="Unlock" method="post" class="d-inline">
                    <input type="hidden" name="userId" value="user-id-here" />
                    <button type="submit" class="btn btn-success btn-sm">Unlock</button>
                </form>
            </td>
        </tr>
    </tbody>
</table>