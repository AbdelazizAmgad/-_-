@model CinemaProject.ViewModels.VerifyOtpVM
@{
    Layout = "~/Areas/Customer/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Verify OTP";
}
<div class="container mt-5 text-white">
    <div class="row justify-content-center">
        <div class="col-md-6 p-4 rounded shadow" style="background-color: #1a1a1a; border: 1px solid #333;">
            <h2 class="text-center mb-4">Check Your Email</h2>
            <form asp-area="Identity" asp-controller="Account" asp-action="VerifyOtp" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger fw-bold mb-3"></div>
                <input type="hidden" asp-for="UserId" />
                <div class="mb-3">
                    <label class="form-label text-light">Enter OTP Code</label>
                    <input asp-for="OTP" type="text" class="form-control bg-dark text-white border-secondary text-center fs-4" maxlength="4" placeholder="0000" required />
                </div>
                <button type="submit" class="btn btn-danger w-100 mt-3">Verify Code</button>
            </form>
        </div>
    </div>
</div>