@model CinemaProject.ViewModels.ResetPasswordVM
@{
    Layout = "~/Areas/Customer/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Reset Password";
}
<div class="container mt-5 text-white">
    <div class="row justify-content-center">
        <div class="col-md-6 p-4 rounded shadow" style="background-color: #1a1a1a; border: 1px solid #333;">
            <h2 class="text-center mb-4">Reset Your Password</h2>
            <form asp-area="Identity" asp-controller="Account" asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger fw-bold mb-3"></div>
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Token" />
                <div class="mb-3">
                    <label class="form-label text-light">New Password</label>
                    <input asp-for="NewPassword" type="password" class="form-control bg-dark text-white border-secondary" required />
                </div>
                <div class="mb-3">
                    <label class="form-label text-light">Confirm New Password</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control bg-dark text-white border-secondary" required />
                </div>
                <button type="submit" class="btn btn-danger w-100 mt-3">Reset Password</button>
            </form>
        </div>
    </div>
</div>