@model CinemaProject.ViewModels.LoginVM
@{
    Layout = "~/Areas/Customer/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Login";
}
<div class="container mt-5 text-white">
    <div class="row justify-content-center">
        <div class="col-md-6 p-4 rounded shadow" style="background-color: #1a1a1a; border: 1px solid #333;">
            <h2 class="text-center mb-4">Login</h2>
            <form asp-area="Identity" asp-controller="Account" asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger fw-bold mb-3"></div>
                <div class="mb-3">
                    <label class="form-label text-light">Email or UserName</label>
                    <input asp-for="UserNameOrEmail" type="text" class="form-control bg-dark text-white border-secondary" />
                </div>
                <div class="mb-3">
                    <label class="form-label text-light">Password</label>
                    <input asp-for="Password" type="password" class="form-control bg-dark text-white border-secondary" />
                </div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label text-light">Remember Me</label>
                    </div>
                    <!-- التعديل هنا: ForgetPassword -->
                    <a href="/Identity/Account/ForgetPassword" class="text-danger text-decoration-none small">Forgot Password?</a>
                </div>
                <button type="submit" class="btn btn-danger w-100 mt-2">Login</button>
                <div class="mt-4 text-center border-top border-secondary pt-3">
                    <a href="/Identity/Account/Register" class="text-danger fw-bold text-decoration-none">Create an Account</a><br /><br />
                    <a href="/Identity/Account/ResendEmailConfirmation" class="text-muted small text-decoration-none">Resend confirmation link.</a>
                </div>
            </form>
        </div>
    </div>
</div>