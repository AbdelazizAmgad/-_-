@model CinemaProject.ViewModels.ResendEmailConfirmationVM
@{
    Layout = "~/Areas/Customer/Views/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Resend Confirmation";
}
<div class="container mt-5 text-white">
    <div class="row justify-content-center">
        <div class="col-md-6 p-4 rounded shadow" style="background-color: #1a1a1a; border: 1px solid #333;">
            <h2 class="text-center mb-4">Resend Confirmation Email</h2>
            <form asp-area="Identity" asp-controller="Account" asp-action="ResendEmailConfirmation" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger fw-bold mb-3"></div>
                <div class="mb-3">
                    <label class="form-label text-light">Email Address</label>
                    <input asp-for="UserNameOrEmail" type="email" class="form-control bg-dark text-white border-secondary" required />
                </div>
                <button type="submit" class="btn btn-danger w-100 mt-3">Resend Link</button>
                <div class="mt-3 text-center">
                    <a href="/Identity/Account/Login" class="text-danger text-decoration-none">Back to Login</a>
                </div>
            </form>
        </div>
    </div>
</div>